---
import { loadMenu } from "../../lib/menu-api";

export async function getStaticPaths() {
  const menu = await loadMenu();
  return (menu.categories ?? []).map((category) => ({
    params: { category: String(category.external_id ?? category.id) },
    props: { menu, category },
  }));
}

const { menu, category } = Astro.props;
const BASE = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{category.name} | {menu.restaurant.name}</title>
  <meta name="description" content={`${category.name} - ${menu.restaurant.name}`} />
  <style>
    @font-face { font-family: Vazir; src: url(`${BASE}fonts/Vazir.ttf`); }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: #fff; font-family: Vazir, Arial, sans-serif; }
    .content { width: min(1100px, 94%); margin: auto; padding-bottom: 100px; }
    .header { text-align: center; padding: 25px 10px; }
    .logo { width: 130px; height: 130px; object-fit: cover; border-radius: 50%; border: 2px solid var(--secondary); }
    .header h1, .category-title h2, .item-body h3 { color: var(--secondary); }
    .category-title { text-align: center; margin: 20px 0 25px; }
    .category-title h2 { display: inline-block; border-bottom: 2px solid var(--secondary); padding: 0 15px 10px; }
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }
    .item { background: rgba(255,255,255,.03); border: 1px solid #292929; border-radius: 15px; overflow: hidden; }
    .item-image { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
    .item-body { padding: 12px; }
    .item-body h3 { margin: 0 0 7px; font-size: 18px; }
    .item-body p { margin: 0 0 12px; color: #ccc; font-size: 13px; line-height: 1.8; }
    .prices { display: flex; flex-direction: column; gap: 4px; }
    .prices del { color: #888; font-size: 12px; }
    .prices strong { color: var(--accent); font-size: 17px; }
    .unavailable { opacity: .45; }
    .soldout { display: inline-block; margin-top: 8px; padding: 4px 10px; border-radius: 8px; background: #333; font-size: 12px; }
    footer { position: fixed; bottom: 0; width: 100%; text-align: center; padding: 15px; background: rgba(15,15,15,.95); border-top: 1px solid #222; color: #aaa; }
    @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } .item-image { aspect-ratio: 16 / 10; } }
  </style>
</head>
<body style={`--bg:${menu.restaurant.theme_background ?? "#000"};--accent:${menu.restaurant.theme_accent ?? "#62ff00"};--secondary:${menu.restaurant.theme_secondary ?? "#fffc36"}`}>
  <main class="content">
    <header class="header">
      <img class="logo" src={`${BASE}${menu.restaurant.logo ?? "/images/logo.png"}`} alt={menu.restaurant.name} />
      <h1>{menu.restaurant.name}</h1>
    </header>
    <section class="category-title"><h2>{category.name}</h2></section>
    <div class="grid">
      {(category.items ?? []).map((item) => (
        <article class:list={["item", !item.available && "unavailable"]}>
          {item.image && <img class="item-image" src={`${BASE}${item.image}`} alt={item.name} loading="lazy" />}
          <div class="item-body">
            <h3>{item.name}</h3>
            {item.description && <p>{item.description}</p>}
            <div class="prices">
              {item.old_price != null && <del>{item.old_price.toLocaleString("fa-IR")} تومان</del>}
              <strong>{item.price.toLocaleString("fa-IR")} تومان</strong>
            </div>
            {!item.available && <span class="soldout">ناموجود</span>}
          </div>
        </article>
      ))}
    </div>
  </main>
  <footer>{menu.restaurant.name}</footer>
</body>
</html>
