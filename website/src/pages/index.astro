---
import "../styles/global.css";
import { loadMenu } from "../lib/menu-api";

const menu = await loadMenu();
const restaurant = menu.restaurant;
const BASE = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const categories = menu.categories ?? [];
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{restaurant.name}</title>
  <meta name="description" content={restaurant.description ?? restaurant.name} />
  <meta name="theme-color" content={restaurant.theme_secondary ?? "#FFFC36"} />
  <link rel="icon" href={`${BASE}images/logo.png`} />
</head>
<body>
  <main>
    <section class="about">
      <img src={`${BASE}${restaurant.logo ?? "/images/logo.png"}`} class="restaurant-logo" alt={restaurant.name} />
      <h1>{restaurant.name}</h1>
      {restaurant.description && <p>{restaurant.description}</p>}
      {restaurant.address && <p class="address">{restaurant.address}</p>}
      <div class="social">
        {restaurant.mobile && <a href={`tel:${restaurant.mobile}`}>📞</a>}
        {restaurant.instagram && <a href={restaurant.instagram} target="_blank" rel="nofollow">📷</a>}
        {restaurant.telegram && <a href={restaurant.telegram} target="_blank" rel="nofollow">✈️</a>}
      </div>
    </section>

    <section class="categories">
      {categories.map((category) => (
        <a href={`${BASE}menu/${category.external_id ?? category.id}`} class="category">
          {category.image && <img src={`${BASE}${category.image}`} alt={category.name} />}
          <div class="category-title">{category.name}</div>
        </a>
      ))}
    </section>

    <div class="footer">❤️ منو دیجیتال {restaurant.name}</div>
  </main>
</body>
</html>
