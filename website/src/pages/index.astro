---
import "../styles/global.css";
import menu from "../data/menu.json";

const restaurant = menu.restaurant;

const BASE = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";

const categories = [
  {
    id: "burger",
    name: "برگر",
    image: `${BASE}images/burger.jpeg`,
    href: `${BASE}menu/burger`
  },
  {
    id: "sandwich",
    name: "ساندویچ",
    image: `${BASE}images/sandwich.jpeg`,
    href: `${BASE}menu/sandwich`
  },
  {
    id: "fried",
    name: "سوخاری",
    image: `${BASE}images/fried.jpeg`,
    href: `${BASE}menu/fried`
  },
  {
    id: "potato",
    name: "سیب‌زمینی",
    image: `${BASE}images/potato.jpeg`,
    href: `${BASE}menu/potato`
  },
  {
    id: "special",
    name: "ویژه",
    image: `${BASE}images/special.jpeg`,
    href: `${BASE}menu/special`
  }
];
---

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{restaurant.name}</title>

  <meta
    name="description"
    content={restaurant.description}
  />

  <meta name="theme-color" content="#FFFC36" />

  <link rel="icon" href={`${import.meta.env.BASE_URL}/images/logo.png`} />
</head>

<body>

  <main>

    <!-- معرفی رستوران -->
    <section class="about">

      <img
        src={`${import.meta.env.BASE_URL}/images/logo.png`}
        class="restaurant-logo"
        alt={restaurant.name}
      />

      <h1>{restaurant.name}</h1>

      <p>با ما مزه‌های جدید و تست کن</p>

      <p class="address">
        کوردستان شهرستان کامیاران خیابان بهشتی جنب پاساژ تجارت
      </p>

      <div class="social">

        <a href="tel:09333440918">
          📞
        </a>

        <a
          href="https://www.instagram.com/khane_sibzamini_kamyaran01/"
          target="_blank"
          rel="nofollow"
        >
          📷
        </a>

      </div>

      <a class="club" href="/caller/Surankhaki">
        🎁 عضویت باشگاه مشتریان 🎁
      </a>

    </section>


    <!-- دسته‌بندی‌ها -->
    <section class="categories">

      {
        categories.map((category) => (
          <a
            href={category.href}
            class="category"
          >

            <img
              src={category.image}
              alt={category.name}
            />

            <div class="category-title">
              {category.name}
            </div>

          </a>
        ))
      }

    </section>


    <div class="footer">

      ❤️
      <a href="https://github.com/herotux">
        منو دیجیتال سافت منو
      </a>

    </div>

  </main>

</body>
</html>
